# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Required -------------------------------------------------------------
# Create a free key at https://app.pinecone.io
PINECONE_API_KEY=

# --- Vector database ------------------------------------------------------
PINECONE_INDEX_NAME=indiantaxgpt
# Used only when ingestion creates a new serverless index.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Embeddings -----------------------------------------------------------
# Changing the model changes the vector dimension; re-run ingestion with --reset.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Local LLM ------------------------------------------------------------
LLM_MODEL_PATH=models/llama-2-7b-chat.Q4_K_M.gguf
LLM_MODEL_TYPE=llama
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_CONTEXT_LENGTH=4096

# --- Ingestion and retrieval ----------------------------------------------
DATA_DIR=data
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=4
